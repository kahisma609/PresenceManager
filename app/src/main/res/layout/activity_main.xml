<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAccueil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8FAFC">

    <!-- Contenu central centré avec weight="1" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/logo_presence" />

        <!-- Titre -->
        <TextView
            android:id="@+id/txtTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PrésenceManager"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F"
            android:layout_marginTop="30dp"
            android:gravity="center" />

        <!-- Description -->
        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Application de gestion des présences des stagiaires"
            android:textSize="16sp"
            android:textColor="#64748B"
            android:layout_marginTop="12dp"
            android:gravity="center" />

        <!-- Bouton Commencer l'appel -->
        <Button
            android:id="@+id/btnCommernicer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Commencer l'appel"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:layout_marginTop="40dp"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- Pied de page -->
    <TextView
        android:id="@+id/txtFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Présence Manager - Version 1.0"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="12dp"
        android:gravity="center" />

</LinearLayout>